# Inventory only: backend does not automatically load .env.
# Export only variables you need. Empty entries below are placeholders, not defaults.
# DATABASE_URL unset => .local/runtime.json created by npm run db:setup.
DATABASE_URL=
NODE_ENV=
SERVE_BUILD=
APP_ORIGIN=
COOKIE_SECURE=
GOTEK_DEFAULT_AI_RESPONSE_QUOTA=
GOTEK_WORKER_WORKSPACE=
GOTEK_KNOWLEDGE_VERSION=
GOTEK_EMBEDDING_MODEL=
GOTEK_EMBEDDING_BATCH_SIZE=
GOTEK_PROMPT_MICROS_PER_1K=
GOTEK_COMPLETION_MICROS_PER_1K=
# Add secret variable names matching providers.secret_ref locally only.
# Never put real credentials in this example or commit .env/.local.
