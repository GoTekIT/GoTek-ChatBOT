{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@api": ["./src/api/api"],
      "@components/*": ["./src/components/*"],
      "@screens/*": ["./src/screens/*"]
    }
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts"
  ]
}
