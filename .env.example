# ==============================================================================
# GOTEK CHATBOT — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DATABASE
# ------------------------------------------------------------------------------
DATABASE_URL=
# Use backend/.local/runtime.json from db:setup for local credentials.
NODE_ENV=
PORT=
APP_ORIGIN=
SERVE_BUILD=
COOKIE_SECURE=

# ------------------------------------------------------------------------------
# 2. MESSAGE BROKER & CACHE (ASYNC JOBS & WORKERS)
# ------------------------------------------------------------------------------
RABBITMQ_URL=
REDIS_URL=

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (GOOGLE OAUTH)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 4. AI & LLM PROVIDERS
# ------------------------------------------------------------------------------
# Tier 1: Groq Ultra-Low Latency Inference (<400ms)
GROQ_API_KEY=

# Tier 2: Google Gemini (Multimodal & High Context)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=

# Tier 3: OpenRouter (DeepSeek, Claude, LLaMA fallback)
OPEN_ROUTER_API=
DEEPSEEK_API_KEY=

# Optional Direct Cloud LLMs
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 5. GOTEK AI MICROSERVICE (PYTHON FASTAPI)
# ------------------------------------------------------------------------------
GOTEK_CUSTOM_LLM_BASE_URL=
AI_SERVICE_URL=

# ------------------------------------------------------------------------------
# 6. RAG, EMBEDDINGS & QUOTAS
# ------------------------------------------------------------------------------
GOTEK_EMBEDDING_MODEL=
GOTEK_EMBEDDING_BATCH_SIZE=
COHERE_API_KEY=
GOTEK_DEFAULT_AI_RESPONSE_QUOTA=

# ------------------------------------------------------------------------------
# 7. VISION OCR & TRAINING
# ------------------------------------------------------------------------------
HF_TOKEN=
ROBOFLOW_API_KEY=

# ------------------------------------------------------------------------------
# 8. EMAIL NOTIFICATIONS (BREVO & SMTP)
# ------------------------------------------------------------------------------
# Primary: Brevo API
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Fallback: Gmail SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Optional in-process Meta ingress/history scheduler; outbound uses separate worker.
META_WORKER_ENABLED=false
# Dedicated gotek_meta_worker login: NOSUPERUSER NOBYPASSRLS. Keep URL secret.
META_WORKER_DATABASE_URL=
