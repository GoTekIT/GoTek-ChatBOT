# GoTek Chatbot local/test environment template.
# SAFE TO COMMIT: every provider value below is empty or a non-secret example.
#
# IMPORTANT: the backend does not load .env automatically. Read docs/ENVIRONMENT.md
# and export this file in the shell before starting the server or a worker:
#   set -a; source .env; set +a
#
# DATABASE_URL left empty means the app uses .local/runtime.json generated by
# `npm run db:setup`. Do not commit .env or .local/runtime.json.

# Application and database ----------------------------------------------------
DATABASE_URL=
NODE_ENV=development
SERVE_BUILD=false
APP_ORIGIN=http://127.0.0.1:4317
COOKIE_SECURE=false

# New-workspace default quota. This is read only during signup; changing it does
# not change an existing workspace budget.
GOTEK_DEFAULT_AI_RESPONSE_QUOTA=1000

# Trusted local worker selection. Keep these blank in the base file and provide
# real UUIDs per command, as described in docs/ENVIRONMENT.md.
GOTEK_WORKER_WORKSPACE=
GOTEK_KNOWLEDGE_VERSION=
GOTEK_EMBEDDING_MODEL=
GOTEK_EMBEDDING_BATCH_SIZE=20

# Integer micro-units per 1,000 tokens used by the local usage ledger. Zero is
# the safe local default and is not a vendor price or a billing approval.
GOTEK_PROMPT_MICROS_PER_1K=0
GOTEK_COMPLETION_MICROS_PER_1K=0

# Provider secrets -----------------------------------------------------------
# The provider registry stores only a secret_ref name. Export a variable whose
# name exactly matches that value when a server-side provider test/worker runs.
# These names are examples only; keep real values in your local secret store.
# GOTEK_OPENAI_API_KEY=
# GOTEK_GEMINI_API_KEY=
# GOTEK_ANTHROPIC_API_KEY=
# GOTEK_CUSTOM_LLM_API_KEY=

# Never put API keys, cookies, JWTs, database passwords or private keys here.
# `claude_code` currently uses the Anthropic-compatible transport in source; it
# does not start a Claude Code CLI process. See docs/ENVIRONMENT.md.
