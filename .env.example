# ==============================================================================
# GOTEK CHATBOT — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DATABASE
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://gotek_app:your_password@127.0.0.1:55432/gotek_chatbot
NODE_ENV=development
PORT=4317
APP_ORIGIN=http://localhost:3001,http://127.0.0.1:3001,http://localhost:4317,http://127.0.0.1:4317
SERVE_BUILD=false
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 2. MESSAGE BROKER & CACHE (ASYNC JOBS & WORKERS)
# ------------------------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (GOOGLE OAUTH)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 4. AI & LLM PROVIDERS
# ------------------------------------------------------------------------------
# Tier 1: Groq Ultra-Low Latency Inference (<400ms)
GROQ_API_KEY=

# Tier 2: Google Gemini (Multimodal & High Context)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash

# Tier 3: OpenRouter (DeepSeek, Claude, LLaMA fallback)
OPEN_ROUTER_API=
DEEPSEEK_API_KEY=

# Optional Direct Cloud LLMs
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 5. GOTEK AI MICROSERVICE (PYTHON FASTAPI)
# ------------------------------------------------------------------------------
GOTEK_CUSTOM_LLM_BASE_URL=http://localhost:8000/v1
AI_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 6. RAG, EMBEDDINGS & QUOTAS
# ------------------------------------------------------------------------------
GOTEK_EMBEDDING_MODEL=text-embedding-3-small
GOTEK_EMBEDDING_BATCH_SIZE=20
COHERE_API_KEY=
GOTEK_DEFAULT_AI_RESPONSE_QUOTA=1000

# ------------------------------------------------------------------------------
# 7. VISION OCR & TRAINING
# ------------------------------------------------------------------------------
HF_TOKEN=
ROBOFLOW_API_KEY=

# ------------------------------------------------------------------------------
# 8. EMAIL NOTIFICATIONS (BREVO & SMTP)
# ------------------------------------------------------------------------------
# Primary: Brevo API
BREVO_API_KEY=
EMAIL_FROM=no-reply@gotek.vn
EMAIL_FROM_NAME=GoTek Chatbot

# Fallback: Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
